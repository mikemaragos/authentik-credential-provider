# CertIssuer Configuration
# Copy to .env and edit values

# AD CS Configuration
CA_SERVER=WIN-6DP39D0OLI8.test.local
CA_NAME=test-WIN-6DP39D0OLI8-CA
CERT_TEMPLATE=AuthentikSmartcard

# LDAP Configuration  
LDAP_SERVER=ldap://WIN-6DP39D0OLI8.test.local
LDAP_BASE_DN=DC=test,DC=local
LDAP_BIND_USER=CN=Administrator,CN=Users,DC=test,DC=local
LDAP_BIND_PASSWORD=YourPasswordHere

# For certsrv web enrollment (Linux)
CERTSRV_USER=Administrator
CERTSRV_PASSWORD=YourPasswordHere
CERTSRV_DOMAIN=TEST

# API Configuration
API_TOKEN=your-secret-api-token-here
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8443

# Certificate Settings
CERT_VALIDITY_HOURS=8
